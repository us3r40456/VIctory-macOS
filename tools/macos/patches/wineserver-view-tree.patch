diff --git a/server/mapping.c b/server/mapping.c
index d1b0fc3..4233509 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -98,6 +98,8 @@ static struct list shared_map_list = LIST_INIT( shared_map_list );
 struct memory_view
 {
     struct list     entry;           /* entry in per-process view list */
+    struct wine_rb_entry rb_entry;   /* entry in the per-process tree of views by base */
+    struct wine_rb_tree *tree;       /* the tree rb_entry is in, NULL if the view is only in the list */
     struct fd      *fd;              /* fd for mapped file */
     struct ranges  *committed;       /* list of committed ranges in this mapping */
     struct shared_map *shared;       /* temp file for shared PE mapping */
@@ -384,13 +386,57 @@ static int create_temp_file( file_pos_t size )
     return fd;
 }
 
+/* The views of a process never overlap, so they are also kept in a tree by base address: the map and unmap
+ * requests then cost O(log n) instead of a walk over every view of the process (a title that maps 64 KiB pages by
+ * the thousand made wineserver spend most of a core in these loops). A view whose base is already in the tree
+ * (cannot happen while views do not overlap) stays list-only and is found by a walk of the list. */
+static int untracked_views;
+
+static int compare_view_base( const void *key, const struct wine_rb_entry *entry )
+{
+    const struct memory_view *view = WINE_RB_ENTRY_VALUE( entry, struct memory_view, rb_entry );
+    client_ptr_t base = *(const client_ptr_t *)key;
+
+    if (base < view->base) return -1;
+    return base > view->base;
+}
+
+void init_mapped_views( struct process *process )
+{
+    wine_rb_init( &process->views_tree, compare_view_base );
+}
+
+/* the view with the greatest base not above addr, or NULL */
+static struct memory_view *find_view_at_or_below( struct process *process, client_ptr_t addr )
+{
+    struct wine_rb_entry *entry = process->views_tree.root, *best = NULL;
+
+    while (entry)
+    {
+        struct memory_view *view = WINE_RB_ENTRY_VALUE( entry, struct memory_view, rb_entry );
+        if (view->base <= addr)
+        {
+            best = entry;
+            entry = entry->right;
+        }
+        else entry = entry->left;
+    }
+    return best ? WINE_RB_ENTRY_VALUE( best, struct memory_view, rb_entry ) : NULL;
+}
+
 /* find a memory view from its base address */
 struct memory_view *find_mapped_view( struct process *process, client_ptr_t base )
 {
     struct memory_view *view;
+    struct wine_rb_entry *entry = wine_rb_get( &process->views_tree, &base );
 
-    LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
-        if (view->base == base) return view;
+    if (entry) return WINE_RB_ENTRY_VALUE( entry, struct memory_view, rb_entry );
+
+    if (untracked_views)
+    {
+        LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
+            if (!view->tree && view->base == base) return view;
+    }
 
     set_error( STATUS_NOT_MAPPED_VIEW );
     return NULL;
@@ -399,10 +445,15 @@ struct memory_view *find_mapped_view( struct process *process, client_ptr_t base
 /* find a memory view from any address inside it */
 static struct memory_view *find_mapped_addr( struct process *process, client_ptr_t addr )
 {
-    struct memory_view *view;
+    struct memory_view *view = find_view_at_or_below( process, addr );
 
-    LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
-        if (addr >= view->base && addr < view->base + view->size) return view;
+    if (view && addr < view->base + view->size) return view;
+
+    if (untracked_views)
+    {
+        LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
+            if (!view->tree && addr >= view->base && addr < view->base + view->size) return view;
+    }
 
     set_error( STATUS_NOT_MAPPED_VIEW );
     return NULL;
@@ -417,12 +468,19 @@ static int is_valid_view_addr( struct process *process, client_ptr_t addr, mem_s
     if (addr & (process->page_size - 1)) return 0;
     if (addr + size < addr) return 0;  /* overflow */
 
-    /* check for overlapping view */
-    LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
+    /* check for overlapping view: the last view starting below the end of the range is the only candidate,
+     * as the views before it end before it starts */
+    if ((view = find_view_at_or_below( process, addr + size - 1 )) && view->base + view->size > addr) return 0;
+
+    if (untracked_views)
     {
-        if (view->base + view->size <= addr) continue;
-        if (view->base >= addr + size) continue;
-        return 0;
+        LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
+        {
+            if (view->tree) continue;
+            if (view->base + view->size <= addr) continue;
+            if (view->base >= addr + size) continue;
+            return 0;
+        }
     }
     return 1;
 }
@@ -440,6 +498,13 @@ static int generate_dll_event( struct thread *thread, int code, struct memory_vi
     return 1;
 }
 
+static void add_view_to_tree( struct process *process, struct memory_view *view )
+{
+    view->tree = NULL;
+    if (!wine_rb_put( &process->views_tree, &view->base, &view->rb_entry )) view->tree = &process->views_tree;
+    else untracked_views++;
+}
+
 /* add a view to the process list */
 /* return 1 if this is the main exe view */
 static int add_process_view( struct thread *thread, struct memory_view *view )
@@ -462,10 +526,12 @@ static int add_process_view( struct thread *thread, struct memory_view *view )
                 process->imagelen = name.len;
             process->image_info = view->image;
             list_add_head( &process->views, &view->entry );
+            add_view_to_tree( process, view );
             return 1;
         }
     }
     list_add_tail( &process->views, &view->entry );
+    add_view_to_tree( process, view );
     return 0;
 }
 
@@ -474,6 +540,8 @@ static void free_memory_view( struct memory_view *view )
     if (view->fd) release_object( view->fd );
     if (view->committed) release_object( view->committed );
     if (view->shared) release_object( view->shared );
+    if (view->tree) wine_rb_remove( view->tree, &view->rb_entry );
+    else if (view->entry.next) untracked_views--;
     list_remove( &view->entry );
     free( view );
 }
